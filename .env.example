# Copia este archivo a .env y llena los valores. .env NUNCA se sube a git.
# En Astro, lo que empieza con PUBLIC_ llega al navegador: ningún secreto lleva ese prefijo.

PUBLIC_SITE_URL=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# SOLO servidor
SUPABASE_SERVICE_ROLE_KEY=

WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=

# SOLO servidor
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
