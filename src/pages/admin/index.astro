---
import Admin from '../../layouts/Admin.astro';
import { formatCOP } from '../../lib/money';

export const prerender = false;

const db = Astro.locals.supabase!;
// Inicio del mes en hora de Colombia (UTC-5, sin horario de verano)
const hoy = new Date(Date.now() - 5 * 3600_000);
const inicioMes = new Date(Date.UTC(hoy.getUTCFullYear(), hoy.getUTCMonth(), 1, 5)).toISOString();

const [porEnviar, ventas, poco] = await Promise.all([
  db.from('orders').select('id', { count: 'exact', head: true }).eq('status', 'paid'),
  db.from('orders').select('total_cop').in('status', ['paid', 'shipped', 'delivered']).gte('paid_at', inicioMes),
  db
    .from('product_variants')
    .select('id, size, color, stock, products!inner(id, name, status)')
    .lte('stock', 3)
    .eq('products.status', 'active')
    .order('stock'),
]);

const ventasMes = (ventas.data ?? []).reduce((n, o) => n + o.total_cop, 0);
const bajos = (poco.data ?? []) as any[];
---

<Admin title="Inicio" active="inicio">
  <h1 class="text-6xl md:text-7xl">Inicio</h1>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    <a href="/admin/pedidos?estado=paid" class="block rounded-md border-2 border-negro p-5 hover:bg-tile">
      <p class="etiqueta text-texto-suave">Pedidos por enviar</p>
      <p class="mt-1 text-6xl">{porEnviar.count ?? 0}</p>
    </a>
    <div class="rounded-md border-2 border-negro p-5">
      <p class="etiqueta text-texto-suave">Ventas del mes</p>
      <p class="mt-1 text-6xl">{formatCOP(ventasMes)}</p>
    </div>
  </div>

  <h2 class="mt-10 text-3xl">Poco stock (3 o menos)</h2>
  {bajos.length === 0 ? (
    <p class="mt-2 text-texto-suave">Todo con stock suficiente.</p>
  ) : (
    <ul class="mt-3 divide-y divide-linea border-y-2 border-negro">
      {bajos.map((v) => (
        <li>
          <a href={`/admin/productos/${v.products.id}`} class="flex justify-between gap-4 py-3 hover:bg-tile md:px-3">
            <span>{v.products.name} <span class="text-texto-suave">· {v.color} · {v.size}</span></span>
            <strong>{v.stock === 0 ? 'Agotado' : `${v.stock} und.`}</strong>
          </a>
        </li>
      ))}
    </ul>
  )}
</Admin>
