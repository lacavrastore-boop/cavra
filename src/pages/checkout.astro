---
import Base from '../layouts/Base.astro';
import CheckoutForm from '../components/islands/CheckoutForm';

export const prerender = false;
---

<Base title="Pagar | Cavra" description="Datos de envío y pago de tu pedido en Cavra.">
  <section class="px-5 pb-28 pt-28 md:px-10 md:pt-36">
    <div class="mx-auto max-w-5xl">
      <h1 class="text-[clamp(4rem,14vw,10rem)] leading-[0.85]">Pagar</h1>
      <CheckoutForm client:load />
    </div>
  </section>
</Base>
