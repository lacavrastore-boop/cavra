---
const fig = 'relative overflow-hidden rounded-xl';
const img = 'absolute inset-0 h-full w-full object-cover';
---

<section class="bg-papel px-5 py-6 md:px-10 md:py-8" aria-labelledby="calle">
  <div class="mx-auto max-w-[1500px] border-t-2 border-negro pt-6 md:pt-8">
    <div>
      <p class="etiqueta mb-4" data-reveal>Hecho en Colombia</p>
      <h2 id="calle" class="whitespace-nowrap text-[clamp(2.5rem,8vw,6.5rem)] leading-[0.85]" data-reveal>Calle pero elegante.</h2>
    </div>

    <div class="mt-8 grid grid-cols-2 gap-3 md:mt-10 md:grid-cols-12 md:gap-5">
      <figure class={`${fig} col-span-2 aspect-[4/5] md:col-span-5 md:row-span-2 md:aspect-auto`} data-reveal>
        <img class={img} src="/img/life/tee.webp" alt="Chico con camiseta crema sentado en escaleras de colores en Medellín" loading="lazy" />
      </figure>
      <figure class={`${fig} col-span-2 aspect-[3/2] md:col-span-7`} data-reveal style="--i:1">
        <img class={img} src="/img/life/group.webp" alt="Grupo de amigos en una terraza de Bogotá al atardecer" loading="lazy" />
      </figure>
      <figure class={`${fig} col-span-2 aspect-[3/2] md:col-span-7`} data-reveal style="--i:2">
        <img class={img} src="/img/life/detail.webp" alt="Detalle de la tela gruesa y el puño de un buzo crema" loading="lazy" />
      </figure>
    </div>

  </div>
</section>
