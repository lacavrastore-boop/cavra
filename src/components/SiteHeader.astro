---
const { pathname } = Astro.url;
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/tienda', label: 'Tienda' },
  { href: '/tienda#drop-1', label: 'Drop 01', nuevo: true },
];
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 transition-transform duration-300 ease-[cubic-bezier(0.23,1,0.32,1)] data-[hidden=true]:-translate-y-full"
>
  <div class="mx-auto flex h-16 max-w-[1500px] items-center justify-between gap-4 px-4 md:h-20 md:px-8">
    <a href="/" aria-label="Cavra, ir al inicio" class="rounded-full bg-papel px-3 py-2">
      <img src="/brand/logo-negro.svg" alt="Cavra" width="140" height="35" class="h-7 w-auto md:h-8" />
    </a>
    <nav aria-label="Principal" class="hidden rounded-full bg-negro p-1.5 text-papel md:flex md:gap-1.5">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={pathname === l.href ? 'page' : undefined}
            class="etiqueta relative rounded-full px-5 py-3 transition-colors duration-200 hover:bg-papel hover:text-negro aria-[current=page]:bg-papel aria-[current=page]:text-negro"
          >
            {l.label}
            {l.nuevo && (
              <span class="pointer-events-none absolute -top-1 right-0.5 rounded-full bg-oxido px-1.5 py-px text-[0.5rem] font-bold uppercase leading-[1.3] tracking-[0.08em] text-papel">
                New
              </span>
            )}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2">
      <a href="/tienda" class="etiqueta rounded-full bg-negro px-4 py-3 text-papel md:hidden">Tienda</a>
      <button
        type="button"
        data-open-cart
        class="relative grid size-12 place-items-center rounded-full bg-negro text-papel transition duration-150 hover:bg-papel hover:text-negro hover:ring-2 hover:ring-inset hover:ring-negro active:scale-95"
        aria-label="Abrir carrito"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path><path d="M3 6h18"></path><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        <span
          data-cart-count
          hidden
          class="absolute -right-1 -top-1 grid size-6 place-items-center rounded-full bg-oxido text-[0.7rem] font-bold tabular-nums text-papel"
          >0</span
        >
      </button>
    </div>
  </div>
</header>
