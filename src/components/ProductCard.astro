---
import { formatCOP } from '../lib/money';
import { totalStock, type Product } from '../data/products';

interface Props {
  product: Product;
  i?: number;
}
const { product, i = 0 } = Astro.props;
const agotado = totalStock(product) === 0;
const main = product.colors[0];
const hover = main.back ?? product.life;
const hoverIsPhoto = !main.back;
---

<article class="group relative" data-reveal style={`--i:${i}`} data-cat={product.category}>
  <a href={`/producto/${product.slug}`} class="block rounded-lg focus-visible:outline-offset-4">
    <div class="relative aspect-[4/5] overflow-hidden rounded-lg bg-tile">
      <img
        src={main.front}
        alt={`${product.name} en ${main.name.toLowerCase()}, vista frontal`}
        loading="lazy"
        class="absolute inset-0 h-full w-full object-contain p-[9%] drop-shadow-[0_18px_24px_rgba(17,17,17,0.18)] transition-[opacity,transform] duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:scale-[0.96] group-hover:opacity-0"
      />
      {
        hover && (
          <img
            src={hover}
            alt=""
            loading="lazy"
            class:list={[
              'absolute inset-0 h-full w-full scale-[1.06] opacity-0 transition-[opacity,transform] duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:scale-100 group-hover:opacity-100',
              hoverIsPhoto ? 'object-cover' : 'object-contain p-[9%] drop-shadow-[0_18px_24px_rgba(17,17,17,0.18)]',
            ]}
          />
        )
      }
      {agotado && <p class="etiqueta absolute left-3 top-3 rounded-full bg-negro px-3 py-1.5 text-papel">Agotado</p>}
      <span
        class="etiqueta absolute bottom-3 right-3 translate-y-2 rounded-full bg-papel px-3 py-2 opacity-0 transition-[opacity,transform] duration-300 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:translate-y-0 group-hover:opacity-100"
        aria-hidden="true">Ver prenda</span
      >
    </div>
    <div class="mt-4 flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-3">
      <div>
        <h3 class="font-display text-[1.7rem] leading-none sm:text-3xl">{product.name}</h3>
        <p class="mt-1 text-sm text-texto-suave">{product.tagline}</p>
      </div>
      <p class="order-first shrink-0 font-semibold tabular-nums sm:order-none sm:pt-0.5">{formatCOP(product.price_cop)}</p>
    </div>
    <ul class="mt-3 flex gap-1.5" aria-label={`${product.colors.length} colores`}>
      {
        product.colors.map((c) => (
          <li class="size-4 rounded-full ring-1 ring-negro/20" style={`background:${c.hex}`} title={c.name} />
        ))
      }
    </ul>
  </a>
</article>
